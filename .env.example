# Safe local example values only. Copy to .env for local shells; do not commit real secrets.

# Application
APP_ENV=development
APP_ADDR=:8080
APP_TIMEZONE=Asia/Shanghai
API_KEY=local-development-key
DATA_MODE=memory

# Query planning
QUERY_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
MAX_QUERY_DAYS=366
REALTIME_WINDOW_DAYS=3
HISTORICAL_SOURCE=hive

# Table names
TABLE_PREFIX=analytics
TABLE_RETAIL=dws_retail_order_daily
TABLE_RENOVATION=dws_renovation_stage_daily

# HiveServer2
HIVE_HOST=hive.example.invalid
HIVE_PORT=10000
HIVE_USERNAME=example_hive_user
HIVE_PASSWORD=example_hive_password
HIVE_DATABASE=analytics
HIVE_AUTH=NONE
HIVE_TRANSPORT_MODE=binary
HIVE_TLS_ENABLED=false
HIVE_TLS_CA_FILE=
HIVE_TLS_CERT_FILE=
HIVE_TLS_KEY_FILE=
HIVE_TLS_SERVER_NAME=hive.example.invalid
HIVE_MAX_OPEN_CONNS=10
HIVE_MAX_IDLE_CONNS=5
HIVE_CONN_MAX_LIFETIME=30m
HIVE_CONN_MAX_IDLE_TIME=5m

# Trino to Hive
TRINO_HOST=trino.example.invalid
TRINO_PORT=8080
TRINO_USER=example_trino_user
TRINO_PASSWORD=example_trino_password
TRINO_CATALOG=hive
TRINO_SCHEMA=analytics
TRINO_SOURCE=home-improvement-query-api
TRINO_QUERY_TIMEOUT=10s
TRINO_TLS_ENABLED=false
TRINO_TLS_CA_FILE=
TRINO_TLS_CERT_FILE=
TRINO_TLS_KEY_FILE=
TRINO_TLS_SERVER_NAME=trino.example.invalid
TRINO_MAX_OPEN_CONNS=10
TRINO_MAX_IDLE_CONNS=5
TRINO_CONN_MAX_LIFETIME=30m
TRINO_CONN_MAX_IDLE_TIME=5m

# StarRocks
STARROCKS_HOST=starrocks.example.invalid
STARROCKS_PORT=9030
STARROCKS_USERNAME=example_starrocks_user
STARROCKS_PASSWORD=example_starrocks_password
STARROCKS_DATABASE=analytics
STARROCKS_DIAL_TIMEOUT=10s
STARROCKS_READ_TIMEOUT=10s
STARROCKS_WRITE_TIMEOUT=10s
STARROCKS_TLS_ENABLED=false
STARROCKS_TLS_CA_FILE=
STARROCKS_TLS_CERT_FILE=
STARROCKS_TLS_KEY_FILE=
STARROCKS_TLS_SERVER_NAME=starrocks.example.invalid
STARROCKS_MAX_OPEN_CONNS=10
STARROCKS_MAX_IDLE_CONNS=5
STARROCKS_CONN_MAX_LIFETIME=30m
STARROCKS_CONN_MAX_IDLE_TIME=5m

# Opt-in integration smoke tests
SMOKE_ORG_ID=ORG-001
SMOKE_STAT_DATE=2026-08-06
